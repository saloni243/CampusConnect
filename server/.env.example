# ──────────────────────────────────────────────────────────────────────────────
# CampusConnect — Server Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Application
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas connection string
# Local:  mongodb://localhost:27017/campusconnect
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/campusconnect
MONGO_URI=mongodb://localhost:27017/campusconnect

# JWT — use a long random string in production (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS — comma-separated list of allowed frontend origins
# Development: http://localhost:5173
# Production:  https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary — for file/image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
