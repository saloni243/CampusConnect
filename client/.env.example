# ──────────────────────────────────────────────────────────────────────────────
# CampusConnect — Client Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL for API requests
# Development: /api  (Vite dev server proxy handles forwarding to localhost:5000)
# Production:  https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api

# Backend root URL — used to resolve static asset URLs like /uploads/image.jpg
# Development: http://localhost:5000
# Production:  https://your-backend.onrender.com
VITE_SERVER_URL=http://localhost:5000
